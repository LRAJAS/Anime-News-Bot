# ==========================================
# TELEGRAM CONFIGURATION
# ==========================================
# Get these from: https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# ==========================================
# AI API KEYS
# ==========================================
# Get Gemini key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Get OpenAI key from: https://platform.openai.com/
# (Optional - only needed if USE_DALLE=True)
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# GOOGLE DRIVE CONFIGURATION
# ==========================================
# Create a folder in Google Drive and paste its ID
# Format: https://drive.google.com/drive/folders/FOLDER_ID_HERE
DRIVE_FOLDER_ID=your_drive_folder_id_here

# ==========================================
# TELEGRAM CHANNELS TO MONITOR
# ==========================================
# Comma-separated list (no spaces)
TARGET_CHANNELS=@channel1,@channel2,@channel3

# ==========================================
# RATE LIMITING
# ==========================================
# Number of Gemini API calls allowed per minute
RATE_LIMIT_PER_MINUTE=10

# ==========================================
# OPTIONAL SETTINGS
# ==========================================
# Use DALL-E for image generation (True/False)
USE_DALLE=False